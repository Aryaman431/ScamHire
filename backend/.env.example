# HireShield Backend Environment Configuration
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Note: In Lambda, use IAM execution role instead of explicit credentials

# S3 Configuration
S3_BUCKET=hireshield-uploads

# DynamoDB Configuration
DYNAMODB_TABLE=hire-shield-analyses

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096

# Auth (optional - demo mode works without these)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER_URL=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Document Processing Limits
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20

# Project Settings
PROJECT_NAME=HireShield
API_V1_STR=/api/v1
