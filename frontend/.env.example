# HireShield Frontend Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
# The base URL for the backend API (e.g., http://localhost:8000 or https://api.example.com)
# Do NOT include /api or /api/v1 suffix - the API client handles that
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: OAuth configuration (if using authentication)
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
